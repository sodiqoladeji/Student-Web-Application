@using WebApplication1.ViewModels
@model List<Teachers>;

@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    ViewData["Title"] = "Teachers";
}
<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0">
            <i class="bi bi-person-video3 text-warning"></i> Teachers
        </h2>
        <a class="btn btn-success" asp-controller="Teachers" asp-action="Create">
            <i class="bi bi-plus-circle"></i> Add New Teacher
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="px-4">ID</th>
                            <th>First Name</th>
                            <th>Last Name</th>
                            <th>Email</th>
                            <th>Department</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var teacher in Model)
                        {
                            <tr>
                                <td class="px-4 align-middle">
                                    <span class="badge bg-secondary">@teacher.Id</span>
                                </td>
                                <td class="align-middle">@teacher.FirstName</td>
                                <td class="align-middle">@teacher.LastName</td>
                                <td class="align-middle">
                                    <i class="bi bi-envelope text-muted"></i> @teacher.Email
                                </td>
                                <td class="align-middle">
                                    <i class="bi bi-building text-muted"></i> @teacher.Department
                                </td>
                                <td class="align-middle text-center">
                                    <div class="btn-group" role="group">
                                        <a class="btn btn-sm btn-outline-info" asp-controller="Teachers" asp-action="Details" asp-route-id="@teacher.Id" title="View Details">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a class="btn btn-sm btn-outline-primary" asp-controller="Teachers" asp-action="Edit" asp-route-id="@teacher.Id" title="Edit">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <form asp-controller="Teachers" asp-action="Delete" asp-route-id="@teacher.Id" method="post" style="display:inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Are you sure you want to delete @teacher.FirstName @teacher.LastName?');" title="Delete">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info mt-4 text-center">
            <i class="bi bi-info-circle"></i> No teachers found. Click "Add New Teacher" to get started!
        </div>
    }
</div>
