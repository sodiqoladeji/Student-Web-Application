@using WebApplication1.ViewModels
@model TeachersDetailsViewModel;
@{
    ViewData["Title"] = "Teacher Details";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm">
                <div class="card-header bg-warning text-dark">
                    <h3 class="mb-0">
                        <i class="bi bi-person-badge-fill"></i> Teacher Details
                    </h3>
                </div>
                <div class="card-body p-4">
                    
                    <!-- Personal Information -->
                    <div class="mb-4">
                        <h5 class="border-bottom pb-2 mb-3 text-warning">
                            👤 Personal Information
                        </h5>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="text-muted small mb-1">Teacher ID</label>
                                <div class="fw-bold"><span class="badge bg-secondary">@Model.Id</span></div>
                            </div>
                            <div class="col-md-12 mb-3">
                                <label class="text-muted small mb-1">Full Name</label>
                                <div class="fw-bold">
                                    <i class="bi bi-person-fill text-warning"></i> @Model.FirstName @Model.LastName
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Employment Information -->
                    <div class="mb-4">
                        <h5 class="border-bottom pb-2 mb-3 text-warning">
                            💼 Employment Information
                        </h5>
                        <div class="mb-3">
                            <label class="text-muted small mb-1">Department</label>
                            <div class="fw-bold">
                                <i class="bi bi-building"></i> @Model.Department
                            </div>
                        </div>
                    </div>

                    <!-- Contact Information -->
                    <div class="mb-4">
                        <h5 class="border-bottom pb-2 mb-3 text-warning">
                            📞 Contact Information
                        </h5>
                        <div class="mb-3">
                            <label class="text-muted small mb-1">Email Address</label>
                            <div class="fw-bold">
                                <i class="bi bi-envelope"></i> @Model.Email
                            </div>
                        </div>
                    </div>

                    <!-- Action Buttons -->
                    <div class="d-flex gap-2 justify-content-end mt-4 pt-3 border-top">
                        <a asp-controller="Teachers" asp-action="Index" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left"></i> Back to List
                        </a>
                        <a asp-controller="Teachers" asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">
                            <i class="bi bi-pencil"></i> Edit Teacher
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>