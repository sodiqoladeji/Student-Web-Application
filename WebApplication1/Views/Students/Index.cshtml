@using WebApplication1.ViewModels
@model List<WebApplication1.DbEntities.StudentEntity>
@{
    ViewData["Title"] = "Students";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0">
            <i class="bi bi-people-fill text-primary"></i> Students
        </h2>
        <a class="btn btn-success" asp-controller="Students" asp-action="Create">
            <i class="bi bi-plus-circle"></i> Add New Student
        </a>
    </div>
    <div class="card shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="px-4">ID</th>
                            <th>First Name</th>
                            <th>Last Name</th>
                            <th>Email</th>
                            <th>Enrollment Date</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var student in Model)
                        {
                            <tr>
                                <td class="px-4 align-middle">
                                    <span class="badge bg-secondary">@student.Id</span>
                                </td>
                                <td class="align-middle">@student.FirstName</td>
                                <td class="align-middle">@student.LastName</td>
                                <td class="align-middle">
                                    <i class="bi bi-envelope text-muted"></i> @student.Email
                                </td>
                                @* <td class="align-middle">
                                    <i class="bi bi-calendar text-muted"></i> @student.EnrolmentDate.ToString("MMM dd, yyyy")
                                </td> *@
                                <td class="align-middle text-center">
                                    <div class="btn-group" role="group">
                                        <a class="btn btn-sm btn-outline-info" asp-controller="Students" asp-action="Details" asp-route-id="@student.Id" title="View Details">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a class="btn btn-sm btn-outline-primary" asp-controller="Students" asp-action="Edit" asp-route-id="@student.Id" title="Edit">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <form asp-controller="Students" asp-action="Delete" asp-route-id="@student.Id" method="post" style="display:inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Are you sure you want to delete @student.FirstName @student.LastName?');" title="Delete">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info mt-4 text-center">
            <i class="bi bi-info-circle"></i> No students found. Click "Add New Student" to get started!
        </div>
    }
</div>


